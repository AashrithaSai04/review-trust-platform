# Copy to .env before running the API
MODEL_DIR=../ml-pipeline/models/distilbert-review-classifier
DEVICE=cpu
MAX_LENGTH=256

MONGO_URI=mongodb://localhost:27017
MONGO_DB=review_trust_db
MONGO_COLLECTION=predictions

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

HIGH_RISK_THRESHOLD=0.7
MEDIUM_RISK_THRESHOLD=0.4
TOP_K_TOKENS=10